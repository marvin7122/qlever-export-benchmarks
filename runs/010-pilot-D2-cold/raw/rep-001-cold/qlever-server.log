# Tier D2 — DISCOVER (medium duplication, realistic)
# Signature joins create moderate duplicate density without a synthetic
# multiplier; use a bounded result while tuning the concrete stream.
PREFIX dblp: <https://dblp.org/rdf/schema#>

CONSTRUCT { ?paper ?p ?o }
WHERE {
  ?paper a dblp:Publication ;
         dblp:publishedInStream <https://dblp.org/streams/conf/stoc> ;
         dblp:hasSignature ?sig .
  ?sig dblp:signatureCreator ?creator .
  ?paper ?p ?o .
}
LIMIT 100000


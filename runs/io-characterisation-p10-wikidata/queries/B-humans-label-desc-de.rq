# I/O-path candidate (io-screen 2026-10-06): two on-disk columns per row,
# German label + German description (longer literal) of humans.
# ~2.0M rows on the public endpoint (2026-10).
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT { ?entity rdfs:label ?label . ?entity schema:description ?desc }
WHERE {
  ?entity wdt:P31 wd:Q5 .
  ?entity rdfs:label ?label . FILTER(LANG(?label) = "de")
  ?entity schema:description ?desc . FILTER(LANG(?desc) = "de")
}

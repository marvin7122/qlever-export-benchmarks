# Tier H-vocab — English labels, large
# Physical: P+O bound scan of wdt:P31 wd:Q5 (class postings), then
# S+P bound SPO scan of rdfs:label. LANG(?label) maps label IDs to
# strings. CONSTRUCT writes entity IRI + label.
# Targets: large sequential class scan, label vocabulary, 1.3 GiB Turtle
# serialize. Same query as wikidata-construct-humans-label-en.
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT { ?entity rdfs:label ?label }
WHERE {
  ?entity wdt:P31 wd:Q5 .
  ?entity rdfs:label ?label .
  FILTER(LANG(?label) = "en")
}


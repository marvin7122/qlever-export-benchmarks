# Tier H-vocab -- VALUES entity IRIs, German labels, 200k subjects
# Physical: no class scan. VALUES binds 200k subjects (wd:Q1..Q200000).
# Each subject does an S+P bound SPO scan of rdfs:label with LANG de.
# German literals are external tier (not in languages-internal), so every
# lookup is a guaranteed external miss on cold caches. Sized so warm reps
# exceed 3 s for stable 2 Hz sampling.
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT { ?entity rdfs:label ?label }
WHERE {

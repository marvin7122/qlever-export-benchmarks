# Tier H-vocab -- VALUES entity IRIs, German labels, 400k subjects (wd:Q1..Q400000)
# Scaled-up variant of H-vocab-random-label-de-200k (fork PR #161 wave-reap A/B):
# scattered external-vocabulary reads, mostly page-cache misses on a cold cache,
# so every CONSTRUCT batch sends more than 256 reads through the io_uring ring.
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT { ?entity rdfs:label ?label }

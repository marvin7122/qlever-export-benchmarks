# Tier I — io_uring proof, on-disk compressed labels
# Same shape as H-vocab-label-large, but LANG=de.
# The Wikidata index sets languages-internal to ["en"] only.
# English labels and wd:Q* IRIs sit in the in-memory half.
# German labels sit in CompressedVocabulary on disk.
# CONSTRUCT emits entity IRI + German label, so export must
# lookupBatch those on-disk words.
# Fail the claim if pread64 does not fall and io_uring_enter
# does not rise on the PR 47 variant, or if elapsed stays at
# the D1/D3 star-dump scale instead of the serialize-bound
# English-label scale.
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT { ?entity rdfs:label ?label }
WHERE {
  ?entity wdt:P31 wd:Q5 .
  ?entity rdfs:label ?label .
  FILTER(LANG(?label) = "de")
}


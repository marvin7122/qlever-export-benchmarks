# Tier D3 — DISCOVER (mid-scale, export share visible)
# A venue subgraph gives a controllable, mid-scale publication workload.
PREFIX dblp: <https://dblp.org/rdf/schema#>

CONSTRUCT { ?paper ?p ?o }
WHERE {
  ?paper a dblp:Publication ;
         dblp:publishedInStream <https://dblp.org/streams/conf/stoc> ;
         ?p ?o .
}
LIMIT 100000


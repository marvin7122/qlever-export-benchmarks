# Tier D4 — DISCOVER (real-world-ish, cross-check against Tier R)
# Materialize a bounded publication subgraph for a second established venue.
PREFIX dblp: <https://dblp.org/rdf/schema#>

CONSTRUCT { ?paper ?p ?o }
WHERE {
  ?paper a dblp:Publication ;
         dblp:publishedInStream <https://dblp.org/streams/conf/sigir> ;
         ?p ?o .
}
LIMIT 50000


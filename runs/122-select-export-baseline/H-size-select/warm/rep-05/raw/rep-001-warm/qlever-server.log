# Tier H — size-sweep (SELECT variant)
# Goal: isolate SELECT CSV/TSV export cost from query-planning cost. Raise
# the year bound across runs, for example 1970, 1990, 2010, and 2023.
PREFIX dblp: <https://dblp.org/rdf/schema#>

SELECT ?s ?p ?o
WHERE {
  ?s a dblp:Publication ;
     dblp:yearOfPublication ?year ;
     ?p ?o .
  FILTER(?year <= "1970"^^<http://www.w3.org/2001/XMLSchema#gYear>)
}


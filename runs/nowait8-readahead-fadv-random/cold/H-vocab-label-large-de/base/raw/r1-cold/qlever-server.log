# Tier H-vocab — German labels, large
# Physical: P+O bound scan of wdt:P31 wd:Q5 (class postings), then
# S+P bound SPO scan of rdfs:label. LANG(?label) maps label IDs to
# strings. CONSTRUCT writes entity IRI + label.
# Targets: large sequential class scan with EXTERNAL vocabulary words.
# German is not in languages-internal (only "en"), so QLever's
# shouldLiteralBeExternalized places every de literal in the external
# tier (src/index/vocabulary/Vocabulary.cpp). Same shape as
# H-vocab-label-large.rq, but every lookup is a guaranteed external
# miss on cold caches.
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT { ?entity rdfs:label ?label }
WHERE {
  ?entity wdt:P31 wd:Q5 .
  ?entity rdfs:label ?label .
  FILTER(LANG(?label) = "de")
}


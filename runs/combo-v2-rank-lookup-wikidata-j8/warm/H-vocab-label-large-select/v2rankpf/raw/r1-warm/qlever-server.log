# Tier H-vocab — English labels, large (SELECT companion)
# Same WHERE clause as H-vocab-label-large.rq, but SELECT ?entity ?label
# instead of CONSTRUCT. Used by run 124 (export term-lookup perf profile)
# to attribute SELECT export CPU between vocabulary lookup and formatting.

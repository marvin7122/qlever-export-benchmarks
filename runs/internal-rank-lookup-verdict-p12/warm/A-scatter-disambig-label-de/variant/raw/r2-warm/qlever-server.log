# label scan. German literals are in the external (on-disk) vocabulary.
# A sparse class spreads its label IDs over the sorted vocabulary, so few
# reads share a page. Public endpoint count (2026-10): ~0.70M German labels.
PREFIX wd: <http://www.wikidata.org/entity/>
